# Create an app at https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
# Must match a Redirect URI registered in your Spotify app dashboard exactly.
# For loopback redirects, the app keeps the configured hostname and path but uses
# the current browser protocol and port at runtime so dev and Docker ports both work.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173

# Optional override. Defaults to ws(s)://<current-host>:6789 when unset.
# VITE_ROTARY_WS_URL=ws://127.0.0.1:6789

VITE_HOME_ASSISTANT_URL=http://homeassistant.local:8123
VITE_HOME_ASSISTANT_TOKEN=your_home_assistant_long_lived_access_token

# Local dev uses a Vite proxy at /__ha so browser requests stay same-origin.